{
    "file_format_version": "1.2.0",
    "layer": {
        "name": "VK_LAYER_MIRADOR_direct_mode",
        "type": "GLOBAL",
        "library_path": ".\\mirador_direct_mode.dll",
        "api_version": "1.4.309",
        "implementation_version": "1",
        "description": "Mirador's direct mode: an NVIDIA direct-mode headset through NVAPI as a VK_KHR_display display (version @PROJECT_VERSION@). Enabled by MIRADOR_DIRECT_MODE=1.",
        "functions": {
            "vkNegotiateLoaderLayerInterfaceVersion": "vkNegotiateLoaderLayerInterfaceVersion"
        },
        "instance_extensions": [
            { "name": "VK_EXT_display_surface_counter", "spec_version": "1" }
        ],
        "device_extensions": [
            {
                "name": "VK_EXT_display_control",
                "spec_version": "1",
                "entrypoints": [
                    "vkDisplayPowerControlEXT",
                    "vkRegisterDeviceEventEXT",
                    "vkRegisterDisplayEventEXT",
                    "vkGetSwapchainCounterEXT"
                ]
            }
        ],
        "enable_environment": {
            "MIRADOR_DIRECT_MODE": "1"
        },
        "disable_environment": {
            "DISABLE_MIRADOR_DIRECT_MODE": "1"
        }
    }
}
