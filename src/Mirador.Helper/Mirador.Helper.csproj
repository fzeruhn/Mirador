<Project Sdk="Microsoft.NET.Sdk.Worker">
  <PropertyGroup>
    <!-- No Windows Runtime APIs here: without the Windows SDK version, the helper ships without its 25 MB projection. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <TargetPlatformMinVersion></TargetPlatformMinVersion>
    <OutputType>Exe</OutputType>
    <RootNamespace>Mirador.Helper</RootNamespace>
    <AssemblyName>Mirador.Helper</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" />
    <PackageReference Include="System.Management" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Mirador.Helper.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Mirador.Ipc\Mirador.Ipc.csproj" />
  </ItemGroup>
</Project>
