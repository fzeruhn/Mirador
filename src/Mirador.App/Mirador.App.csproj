<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>Mirador.App</RootNamespace>
    <AssemblyName>Mirador</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <ApplicationIcon>Assets\Mirador.ico</ApplicationIcon>
    <!-- Program.cs has Main: the elevated runtime switch and the second-instance hand-over come before any WinUI. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="Assets\*.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- gaze_world (the dots of "Check my calibration") and its OpenXR loader, when a build of it is at GazeWorldDir. -->
  <PropertyGroup>
    <GazeWorldDir Condition="'$(GazeWorldDir)' == ''">$(MSBuildThisFileDirectory)..\..\..\DreamAirWin\tools\gaze_world</GazeWorldDir>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(GazeWorldDir)\gaze_world.exe" Link="tools\gaze_world.exe" CopyToOutputDirectory="PreserveNewest" Condition="Exists('$(GazeWorldDir)\gaze_world.exe')" />
    <None Include="$(GazeWorldDir)\openxr_loader.dll" Link="tools\openxr_loader.dll" CopyToOutputDirectory="PreserveNewest" Condition="Exists('$(GazeWorldDir)\openxr_loader.dll')" />
  </ItemGroup>
  <!-- The stand-in (standin\build.ps1), when it has been built: copied into build folders, it lets games start Monado. -->
  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)..\..\artifacts\standin\monado-service.exe')">
    <None Include="$(MSBuildThisFileDirectory)..\..\artifacts\standin\monado-service.exe" Link="standin\monado-service.exe" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" />
    <PackageReference Include="H.NotifyIcon.WinUI" />
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <!-- The Windows App SDK's AI, machine learning (onnxruntime, DirectML), search and widgets parts: unused. -->
    <PackageReference Include="Microsoft.WindowsAppSDK.AI" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.WindowsAppSDK.ML" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Search" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Widgets" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.Windows.AI.MachineLearning" ExcludeAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Mirador.Core\Mirador.Core.csproj" />
    <ProjectReference Include="..\Mirador.DreamAir\Mirador.DreamAir.csproj" />
    <ProjectReference Include="..\Mirador.Ipc\Mirador.Ipc.csproj" />
  </ItemGroup>
</Project>
