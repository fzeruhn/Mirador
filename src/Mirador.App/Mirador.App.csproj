<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>Mirador.App</RootNamespace>
    <AssemblyName>Mirador</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <ApplicationIcon>Assets\Mirador.ico</ApplicationIcon>
    <!-- Program.cs has Main: the elevated runtime switch and the second-instance hand-over come before any WinUI. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="Assets\*.ico;Assets\*.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- Monado's build recipe and Mirador's vcpkg pin (the bundle copies them too), so a run from the build output builds branches and checks the build tools. -->
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)..\..\tools\build-monado.ps1" Link="tools\build-monado.ps1" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(MSBuildThisFileDirectory)..\..\tools\vcpkg-commit.txt" Link="tools\vcpkg-commit.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(MSBuildThisFileDirectory)..\..\artifacts\xr-check-build\xr-check.exe" Link="tools\xr-check.exe" CopyToOutputDirectory="PreserveNewest" Condition="Exists('$(MSBuildThisFileDirectory)..\..\artifacts\xr-check-build\xr-check.exe')" />
  </ItemGroup>
  <!-- The stand-in (standin\build.ps1), when it has been built: copied into build folders, it lets games start Monado. -->
  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)..\..\artifacts\standin\monado-service.exe')">
    <None Include="$(MSBuildThisFileDirectory)..\..\artifacts\standin\monado-service.exe" Link="standin\monado-service.exe" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" />
    <PackageReference Include="H.NotifyIcon.WinUI" />
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <!-- The Windows App SDK's AI, machine learning (onnxruntime, DirectML), search and widgets parts: unused. -->
    <PackageReference Include="Microsoft.WindowsAppSDK.AI" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.WindowsAppSDK.ML" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Search" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Widgets" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.Windows.AI.MachineLearning" ExcludeAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Mirador.Core\Mirador.Core.csproj" />
    <ProjectReference Include="..\Mirador.Pimax\Mirador.Pimax.csproj" />
    <ProjectReference Include="..\Mirador.Ipc\Mirador.Ipc.csproj" />
  </ItemGroup>
</Project>
