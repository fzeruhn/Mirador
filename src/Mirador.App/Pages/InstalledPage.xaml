<Page
    x:Class="Mirador.App.Pages.InstalledPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:Mirador.App.Controls"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:vm="using:Mirador.App.ViewModels">

    <ScrollViewer>
        <c:PageColumn>
        <StackPanel Style="{StaticResource PageStack}">
            <TextBlock Style="{StaticResource PageTitle}" Text="Installed" />

            <TextBlock Style="{StaticResource FirstSectionHeader}" Text="Mirador" />
            <ItemsControl ItemsSource="{x:Bind ViewModel.Parts}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="4" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:InstalledItem">
                        <toolkit:SettingsCard Description="{x:Bind Detail}" Header="{x:Bind Name}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Style="{StaticResource SectionHeader}" Text="Build tools" />
            <TextBlock
                Margin="0,0,0,4"
                Text="A branch build installs what it needs first, at the versions every build uses."
                TextWrapping="Wrap" />
            <InfoBar
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.HasProblem, Mode=OneWay}"
                Message="{x:Bind ViewModel.Problem, Mode=OneWay}"
                Severity="Error"
                Visibility="{Binding IsOpen, RelativeSource={RelativeSource Mode=Self}, Converter={StaticResource VisibleWhenTrue}}" />
            <ProgressRing
                Width="20"
                Height="20"
                HorizontalAlignment="Left"
                IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource VisibleWhenTrue}}" />
            <ItemsControl ItemsSource="{x:Bind ViewModel.BuildTools}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="4" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:InstalledItem">
                        <toolkit:SettingsCard Description="{x:Bind Detail}" Header="{x:Bind Name}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
        </c:PageColumn>
    </ScrollViewer>
</Page>
