<Page
    x:Class="Mirador.App.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:Mirador.App.Controls"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls">

    <ScrollViewer>
        <c:PageColumn>
        <StackPanel Style="{StaticResource PageStack}">
            <TextBlock Style="{StaticResource PageTitle}" Text="App settings" />

            <InfoBar
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.HasProblem, Mode=OneWay}"
                Message="{x:Bind ViewModel.Problem, Mode=OneWay}"
                Severity="Error"
                Visibility="{Binding IsOpen, RelativeSource={RelativeSource Mode=Self}, Converter={StaticResource VisibleWhenTrue}}" />

            <TextBlock Style="{StaticResource FirstSectionHeader}" Text="General" />
            <toolkit:SettingsCard Description="Windows starts Mirador when you sign in, so it is ready when a game wants Monado." Header="Start Mirador when you sign in">
                <ToggleSwitch IsOn="{x:Bind ViewModel.StartAtSignIn, Mode=TwoWay}" />
            </toolkit:SettingsCard>
            <toolkit:SettingsCard Description="Start in the notification area when Windows starts Mirador." Header="Start minimized" IsEnabled="{x:Bind ViewModel.StartAtSignIn, Mode=OneWay}">
                <ToggleSwitch IsOn="{x:Bind ViewModel.StartMinimized, Mode=TwoWay}" />
            </toolkit:SettingsCard>
            <toolkit:SettingsCard Description="Closing the window keeps Mirador in the notification area, so games can still start Monado. Quit it from the tray icon." Header="Close to the tray">
                <ToggleSwitch IsOn="{x:Bind ViewModel.CloseToTray, Mode=TwoWay}" />
            </toolkit:SettingsCard>
            <toolkit:SettingsCard Description="Once a day at most, Mirador asks GitHub whether a newer release is out and says so on Home. It never installs anything by itself." Header="Check for updates">
                <ToggleSwitch IsOn="{x:Bind ViewModel.CheckForUpdates, Mode=TwoWay}" />
            </toolkit:SettingsCard>

            <TextBlock Style="{StaticResource SectionHeader}" Text="About" />
            <toolkit:SettingsCard Description="Runs Monado, the open-source OpenXR runtime, on Windows. Boost Software License 1.0." Header="{x:Bind ViewModel.Version}">
                <HyperlinkButton Content="github.com/fzeruhn/Mirador" NavigateUri="https://github.com/fzeruhn/Mirador" />
            </toolkit:SettingsCard>
        </StackPanel>
        </c:PageColumn>
    </ScrollViewer>
</Page>
