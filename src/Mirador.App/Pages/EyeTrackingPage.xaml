<Page
    x:Class="Mirador.App.Pages.EyeTrackingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:vm="using:Mirador.App.ViewModels"
    NavigationCacheMode="Required">

    <ScrollViewer>
        <StackPanel MaxWidth="900" Padding="36,24,36,36" Spacing="4">
            <TextBlock Margin="0,0,0,12" Style="{StaticResource TitleTextBlockStyle}" Text="Eye tracking" />

            <toolkit:SettingsCard
                Description="Put the headset on and look at each dot in turn. The check takes about a minute."
                Header="Check my calibration">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <ProgressRing Width="20" Height="20" IsActive="{x:Bind ViewModel.IsChecking, Mode=OneWay}" />
                    <Button Command="{x:Bind ViewModel.RunCheckCommand}" Content="Check" Style="{StaticResource AccentButtonStyle}" />
                </StackPanel>
            </toolkit:SettingsCard>
            <TextBlock
                Margin="16,4,0,0"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind ViewModel.LastCheck, Mode=OneWay}" />
            <TextBlock Margin="16,4,0,0" Text="{x:Bind ViewModel.Progress, Mode=OneWay}" TextWrapping="Wrap" />
            <InfoBar
                Margin="0,8,0,0"
                Closed="OnResultClosed"
                IsClosable="True"
                IsOpen="{x:Bind ViewModel.HasResult, Mode=OneWay}"
                Message="{x:Bind ViewModel.Result, Mode=OneWay}"
                Severity="{x:Bind ViewModel.ResultSeverity, Mode=OneWay}" />

            <toolkit:SettingsCard Margin="0,16,0,0" Description="{x:Bind ViewModel.VariantSource, Mode=OneWay}" Header="Headset variant">
                <ComboBox
                    MinWidth="200"
                    ItemsSource="{x:Bind ViewModel.Variants}"
                    SelectedItem="{x:Bind ViewModel.SelectedVariant, Mode=TwoWay, Converter={StaticResource ProfileConverter}}" />
            </toolkit:SettingsCard>
            <TextBlock
                Margin="16,4,0,0"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="The eye tracker's geometry differs between variants; Mirador uploads the one for yours at every Start."
                TextWrapping="Wrap" />

            <TextBlock Margin="0,24,0,4" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Calibration backups" />
            <TextBlock
                Margin="0,0,0,8"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Mirador keeps a copy of the eye calibration whenever it changes. Monado uses the restored calibration unless the eye tracker holds its own from Pimax Play; then it keeps the tracker's and says so."
                TextWrapping="Wrap" />
            <toolkit:SettingsCard Description="Save the calibration to a file, or take one in from another PC." Header="Export and import">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ComboBox
                        MinWidth="200"
                        ItemsSource="{x:Bind ViewModel.Serials}"
                        PlaceholderText="No calibration yet"
                        SelectedItem="{x:Bind ViewModel.SelectedSerial, Mode=TwoWay, Converter={StaticResource ProfileConverter}}" />
                    <Button Click="OnExport" Content="Export…" IsEnabled="{x:Bind ViewModel.HasSerials, Mode=OneWay}" />
                    <Button Click="OnImport" Content="Import…" />
                </StackPanel>
            </toolkit:SettingsCard>
            <ItemsControl Margin="0,4,0,0" ItemsSource="{x:Bind ViewModel.Backups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:BackupItem">
                        <toolkit:SettingsCard Margin="0,0,0,4" Header="{x:Bind Text}">
                            <Button Click="OnRestore" Content="Restore" />
                        </toolkit:SettingsCard>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <InfoBar
                Margin="0,8,0,0"
                Closed="OnBackupMessageClosed"
                IsClosable="True"
                IsOpen="{x:Bind ViewModel.HasBackupMessage, Mode=OneWay}"
                Message="{x:Bind ViewModel.BackupMessage, Mode=OneWay}"
                Severity="{x:Bind ViewModel.BackupSeverity, Mode=OneWay}" />
        </StackPanel>
    </ScrollViewer>
</Page>
