<Page
    x:Class="Mirador.App.Pages.ProfilesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:Mirador.App.Controls"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:vm="using:Mirador.App.ViewModels"
    NavigationCacheMode="Required">

    <Page.Resources>
        <!-- A list command: an icon button without a frame until it is pointed at, like a toolbar's. -->
        <Style x:Key="ListCommand" TargetType="Button">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="FontSize" Value="16" />
        </Style>
    </Page.Resources>

    <!--
        List and details: the profiles on the left with their commands above them, the selected one's settings on the
        right, and Save and Revert under the settings, always in view.
    -->
    <Grid Padding="36,24,36,24" ColumnSpacing="24" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock
            Grid.ColumnSpan="2"
            Style="{StaticResource PageTitle}"
            Text="Profiles" />

        <!--  The list  -->
        <Grid
            Grid.Row="1"
            Grid.RowSpan="2"
            RowSpacing="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <!-- The list's commands, as icons with their names as tooltips (a toolbar over the list). -->
            <StackPanel Orientation="Horizontal" Spacing="4">
                <Button
                    AutomationProperties.Name="Add"
                    Command="{x:Bind ViewModel.AddCommand}"
                    IsEnabled="{x:Bind ViewModel.CanSwitch, Mode=OneWay}"
                    Style="{StaticResource ListCommand}"
                    ToolTipService.ToolTip="Add">
                    <FontIcon Glyph="&#xE710;" />
                </Button>
                <Button
                    AutomationProperties.Name="Duplicate"
                    Command="{x:Bind ViewModel.DuplicateCommand}"
                    IsEnabled="{x:Bind ViewModel.CanSwitch, Mode=OneWay}"
                    Style="{StaticResource ListCommand}"
                    ToolTipService.ToolTip="Duplicate">
                    <FontIcon Glyph="&#xE8C8;" />
                </Button>
                <Button
                    AutomationProperties.Name="Rename"
                    Click="OnRename"
                    IsEnabled="{x:Bind ViewModel.CanSwitch, Mode=OneWay}"
                    Style="{StaticResource ListCommand}"
                    ToolTipService.ToolTip="Rename">
                    <FontIcon Glyph="&#xE8AC;" />
                </Button>
                <Button
                    AutomationProperties.Name="Delete"
                    Click="OnDelete"
                    IsEnabled="{x:Bind ViewModel.CanSwitch, Mode=OneWay}"
                    Style="{StaticResource ListCommand}"
                    ToolTipService.ToolTip="Delete">
                    <FontIcon Glyph="&#xE74D;" />
                </Button>
            </StackPanel>
            <ListView
                Grid.Row="1"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                IsEnabled="{x:Bind ViewModel.CanSwitch, Mode=OneWay}"
                ItemsSource="{x:Bind ViewModel.Profiles}"
                SelectedItem="{x:Bind ViewModel.Selected, Mode=TwoWay, Converter={StaticResource ProfileConverter}}"
                SelectionMode="Single" />
            <TextBlock
                Grid.Row="2"
                Margin="0,4,0,0"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="Save or revert your changes first."
                TextWrapping="Wrap"
                Visibility="{x:Bind ViewModel.IsDirty, Mode=OneWay}" />
        </Grid>

        <!--  The details  -->
        <ScrollViewer Grid.Row="1" Grid.Column="1">
            <c:PageColumn IsCentered="False" MaxColumnWidth="700">
            <StackPanel Spacing="4">
                <InfoBar
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.IsRunning, Mode=OneWay}"
                    Message="Changes apply the next time Monado starts."
                    Severity="Informational"
                    Visibility="{Binding IsOpen, RelativeSource={RelativeSource Mode=Self}, Converter={StaticResource VisibleWhenTrue}}" />
                <InfoBar
                    Closed="OnMessageClosed"
                    IsClosable="True"
                    IsOpen="{x:Bind ViewModel.HasMessage, Mode=OneWay}"
                    Message="{x:Bind ViewModel.Message, Mode=OneWay}"
                    Severity="Error"
                    Visibility="{Binding IsOpen, RelativeSource={RelativeSource Mode=Self}, Converter={StaticResource VisibleWhenTrue}}" />

                <TextBlock Margin="1,4,0,6" Style="{StaticResource SectionHeader}" Text="Profile" />
                <toolkit:SettingsCard Header="Name">
                    <TextBox MinWidth="200" Text="{x:Bind ViewModel.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </toolkit:SettingsCard>

                <TextBlock Style="{StaticResource SectionHeader}" Text="Builds" />
                <toolkit:SettingsCard Description="Mirador's Monado is upstream's nightly build. Or Mirador builds a branch for you, or runs one you built." Header="Monado">
                    <ComboBox MinWidth="200" SelectedIndex="{x:Bind ViewModel.MonadoSource, Mode=TwoWay}">
                        <ComboBoxItem Content="Mirador's Monado" />
                        <ComboBoxItem Content="Build upstream main" />
                        <ComboBoxItem Content="Build from a link" />
                        <ComboBoxItem Content="A build folder" />
                    </ComboBox>
                </toolkit:SettingsCard>
                <toolkit:SettingsCard
                    ContentAlignment="Vertical"
                    Description="A branch or merge request on GitLab or GitHub: paste its page's link."
                    Header="Link"
                    HorizontalContentAlignment="Stretch"
                    Visibility="{x:Bind ViewModel.MonadoFromLink, Mode=OneWay}">
                    <TextBox PlaceholderText="https://gitlab.freedesktop.org/you/monado/-/tree/your-branch" Text="{x:Bind ViewModel.MonadoLink, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </toolkit:SettingsCard>
                <toolkit:SettingsCard
                    Description="Filled in from the link."
                    Header="Branch"
                    Visibility="{x:Bind ViewModel.MonadoFromLink, Mode=OneWay}">
                    <TextBox MinWidth="200" Text="{x:Bind ViewModel.MonadoBranch, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </toolkit:SettingsCard>
                <toolkit:SettingsCard
                    ContentAlignment="Vertical"
                    Description="Only if the branch needs them: -DNAME=value, one per line. They come after Mirador's own."
                    Header="Extra CMake options"
                    HorizontalContentAlignment="Stretch"
                    Visibility="{x:Bind ViewModel.MonadoFromLink, Mode=OneWay}">
                    <TextBox AcceptsReturn="True" MinHeight="60" Text="{x:Bind ViewModel.MonadoOptions, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </toolkit:SettingsCard>
                <toolkit:SettingsCard
                    Description="{x:Bind ViewModel.MiradorMonado.Status, Mode=OneWay}"
                    Header="Mirador's Monado"
                    Visibility="{x:Bind ViewModel.MiradorMonado.IsVisible, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ProgressRing
                            Width="20"
                            Height="20"
                            IsActive="{x:Bind ViewModel.MiradorMonado.IsBusy, Mode=OneWay}" />
                        <Button Command="{x:Bind ViewModel.MiradorMonado.CheckCommand}" Content="Check" />
                        <Button Command="{x:Bind ViewModel.MiradorMonado.RollBackCommand}" Content="Roll back" />
                        <Button
                            Command="{x:Bind ViewModel.MiradorMonado.InstallCommand}"
                            Content="{x:Bind ViewModel.MiradorMonado.InstallLabel, Mode=OneWay}"
                            Style="{StaticResource AccentButtonStyle}" />
                    </StackPanel>
                </toolkit:SettingsCard>
                <toolkit:SettingsCard
                    Description="Only turn this on if you trust this Monado branch: it gets full control of your PC while it runs. Approving copies the build where only administrators can change it; each new build runs as you until you approve it again. Monado as administrator also needs the elevation fix, which upstream doesn't have yet."
                    Header="Run as administrator"
                    Visibility="{x:Bind ViewModel.CanApprove, Mode=OneWay}">
                    <ToggleSwitch IsOn="{x:Bind ViewModel.RunAsAdministrator, Mode=TwoWay}" />
                </toolkit:SettingsCard>
                <toolkit:SettingsCard
                    Description="{x:Bind ViewModel.ApprovalStatus, Mode=OneWay}"
                    Header="Approved build"
                    Visibility="{x:Bind ViewModel.CanApprove, Mode=OneWay}">
                    <Button Command="{x:Bind ViewModel.ApproveCommand}" Content="Approve" />
                </toolkit:SettingsCard>
                <toolkit:SettingsCard
                    Description="{x:Bind ViewModel.Build.Status, Mode=OneWay}"
                    Header="Build"
                    Visibility="{x:Bind ViewModel.Build.IsVisible, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ProgressRing
                            Width="20"
                            Height="20"
                            IsActive="{x:Bind ViewModel.Build.IsBuilding, Mode=OneWay}" />
                        <Button Click="OnCheckBuildTools" Content="Check build tools" />
                        <Button Command="{x:Bind ViewModel.Build.CancelCommand}" Content="Cancel" />
                        <Button Command="{x:Bind ViewModel.Build.OpenLogCommand}" Content="Open log" />
                        <Button
                            Command="{x:Bind ViewModel.Build.BuildCommand}"
                            Content="{x:Bind ViewModel.Build.BuildLabel, Mode=OneWay}"
                            Style="{StaticResource AccentButtonStyle}" />
                    </StackPanel>
                </toolkit:SettingsCard>
                <Expander
                    Margin="0,0,0,4"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    Header="Build log"
                    Visibility="{x:Bind ViewModel.Build.IsVisible, Mode=OneWay}">
                    <TextBox
                        MaxHeight="320"
                        FontFamily="Consolas"
                        FontSize="12"
                        IsReadOnly="True"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        Text="{x:Bind ViewModel.Build.Log, Mode=OneWay}"
                        TextWrapping="NoWrap" />
                </Expander>
                <toolkit:SettingsCard
                    ContentAlignment="Vertical"
                    Header="Monado build folder"
                    HorizontalContentAlignment="Stretch"
                    Visibility="{x:Bind ViewModel.MonadoFromFolder, Mode=OneWay}">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox PlaceholderText="C:\Users\you\Projects\monado\build" Text="{x:Bind ViewModel.MonadoFolder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <Button
                            Grid.Column="1"
                            Click="OnBrowseMonado"
                            Content="Browse…" />
                    </Grid>
                </toolkit:SettingsCard>
                <toolkit:SettingsExpander
                    Description="{x:Bind ViewModel.Verify.Status, Mode=OneWay}"
                    Header="Verify build for Windows"
                    Visibility="{x:Bind ViewModel.Verify.IsVisible, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ProgressRing
                            Width="20"
                            Height="20"
                            IsActive="{x:Bind ViewModel.Verify.IsBusy, Mode=OneWay}" />
                        <Button Command="{x:Bind ViewModel.Verify.CancelCommand}" Content="Cancel" />
                        <Button Command="{x:Bind ViewModel.Verify.VerifyCommand}" Content="Verify" />
                    </StackPanel>
                    <toolkit:SettingsExpander.Items>
                        <toolkit:SettingsCard ContentAlignment="Left">
                            <TextBlock
                                IsTextSelectionEnabled="True"
                                Text="{x:Bind ViewModel.Verify.Details, Mode=OneWay}"
                                TextWrapping="Wrap" />
                        </toolkit:SettingsCard>
                    </toolkit:SettingsExpander.Items>
                </toolkit:SettingsExpander>

                <!-- What Mirador does on Windows for the headset: one choice turns all of it on, the layer included. -->
                <TextBlock Style="{StaticResource SectionHeader}" Text="Windows tools" />
                <toolkit:SettingsCard Description="{x:Bind ViewModel.HeadsetDescription, Mode=OneWay}" Header="Headset">
                    <ComboBox
                        MinWidth="200"
                        ItemsSource="{x:Bind ViewModel.Headsets}"
                        SelectedItem="{x:Bind ViewModel.Headset, Mode=TwoWay, Converter={StaticResource ProfileConverter}}" />
                </toolkit:SettingsCard>

                <TextBlock Style="{StaticResource SectionHeader}" Text="Lighthouse" />
                <toolkit:SettingsCard Description="This setup tracks with base stations: Home gets their On and Off, and Mirador can switch them with Monado (App settings)." Header="Lighthouse base stations">
                    <ToggleSwitch IsOn="{x:Bind ViewModel.UsesBaseStations, Mode=TwoWay}" />
                </toolkit:SettingsCard>

                <TextBlock Style="{StaticResource SectionHeader}" Text="Extra environment" />
                <toolkit:SettingsCard
                    ContentAlignment="Vertical"
                    Description="Variables for Monado; they override the Monado settings for this profile. An empty value removes one."
                    Header="Variables"
                    HorizontalContentAlignment="Stretch">
                    <StackPanel Spacing="8">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Extra}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="8" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:EnvRow">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="3*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox PlaceholderText="Name" Text="{x:Bind Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBox
                                            Grid.Column="1"
                                            PlaceholderText="Value"
                                            Text="{x:Bind Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <Button
                                            Grid.Column="2"
                                            AutomationProperties.Name="Remove"
                                            Click="OnRemoveVariable"
                                            ToolTipService.ToolTip="Remove">
                                            <FontIcon FontSize="14" Glyph="&#xE711;" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Command="{x:Bind ViewModel.AddVariableCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="14" Glyph="&#xE710;" />
                                <TextBlock Text="Add a variable" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </toolkit:SettingsCard>

                <!-- What stops a save: it goes as soon as the profile is fixed. -->
                <InfoBar
                    Margin="0,8,0,0"
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.HasProblems, Mode=OneWay}"
                    Message="{x:Bind ViewModel.ProblemsText, Mode=OneWay}"
                    Severity="Error"
                    Title="Can't save yet"
                    Visibility="{Binding IsOpen, RelativeSource={RelativeSource Mode=Self}, Converter={StaticResource VisibleWhenTrue}}" />
            </StackPanel>
            </c:PageColumn>
        </ScrollViewer>

        <StackPanel
            Grid.Row="2"
            Grid.Column="1"
            Orientation="Horizontal"
            Spacing="8">
            <Button
                MinWidth="96"
                Command="{x:Bind ViewModel.SaveCommand}"
                Content="Save"
                Style="{StaticResource AccentButtonStyle}" />
            <Button
                MinWidth="96"
                Command="{x:Bind ViewModel.RevertCommand}"
                Content="Revert" />
        </StackPanel>
    </Grid>
</Page>
