<Page
    x:Class="Mirador.App.Pages.ProfilesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Mirador.App.ViewModels">

    <Grid Padding="36,24,36,24" ColumnSpacing="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.ColumnSpan="2" Style="{StaticResource TitleTextBlockStyle}" Text="Profiles" />

        <!--  The list  -->
        <Grid Grid.Row="1" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ListView
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                IsEnabled="{x:Bind ViewModel.CanSwitch, Mode=OneWay}"
                ItemsSource="{x:Bind ViewModel.Profiles}"
                SelectedItem="{x:Bind ViewModel.Selected, Mode=TwoWay, Converter={StaticResource ProfileConverter}}"
                SelectionMode="Single" />
            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
                <Button Command="{x:Bind ViewModel.AddCommand}" Content="Add" IsEnabled="{x:Bind ViewModel.CanSwitch, Mode=OneWay}" />
                <Button Command="{x:Bind ViewModel.DuplicateCommand}" Content="Duplicate" IsEnabled="{x:Bind ViewModel.CanSwitch, Mode=OneWay}" />
            </StackPanel>
            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
                <Button Click="OnRename" Content="Rename" IsEnabled="{x:Bind ViewModel.CanSwitch, Mode=OneWay}" />
                <Button Click="OnDelete" Content="Delete" IsEnabled="{x:Bind ViewModel.CanSwitch, Mode=OneWay}" />
            </StackPanel>
            <TextBlock
                Grid.Row="2"
                Margin="0,40,0,0"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Save or revert your changes first."
                TextWrapping="Wrap"
                Visibility="{x:Bind ViewModel.IsDirty, Mode=OneWay}" />
        </Grid>

        <!--  The editor  -->
        <ScrollViewer Grid.Row="1" Grid.Column="1">
            <StackPanel MaxWidth="640" HorizontalAlignment="Left" Spacing="16">
                <InfoBar
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.IsRunning, Mode=OneWay}"
                    Message="Changes apply the next time Monado starts."
                    Severity="Informational" />
                <InfoBar
                    IsClosable="True"
                    IsOpen="{x:Bind ViewModel.HasMessage, Mode=OneWay}"
                    Message="{x:Bind ViewModel.Message, Mode=OneWay}"
                    Severity="Error" />

                <TextBox Header="Name" Text="{x:Bind ViewModel.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <ComboBox
                    MinWidth="240"
                    Header="Headset"
                    ItemsSource="{x:Bind ViewModel.Headsets}"
                    SelectedItem="{x:Bind ViewModel.Headset, Mode=TwoWay, Converter={StaticResource ProfileConverter}}" />

                <StackPanel Spacing="4">
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Monado build" />
                    <RadioButton Content="The one that comes with Mirador" GroupName="Monado" IsChecked="{x:Bind ViewModel.MonadoBundled, Mode=TwoWay}" />
                    <RadioButton Content="A build folder" GroupName="Monado" IsChecked="{x:Bind ViewModel.MonadoFromFolder, Mode=TwoWay}" />
                    <Grid Margin="28,0,0,0" ColumnSpacing="8" Visibility="{x:Bind ViewModel.MonadoFromFolder, Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox PlaceholderText="C:\Users\you\Projects\monado\build" Text="{x:Bind ViewModel.MonadoFolder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="1" Click="OnBrowseMonado" Content="Browse…" />
                    </Grid>
                </StackPanel>

                <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.IsDreamAir, Mode=OneWay}">
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Vulkan layer" />
                    <RadioButton Content="The one that comes with Mirador" GroupName="Layer" IsChecked="{x:Bind ViewModel.LayerBundled, Mode=TwoWay}" />
                    <RadioButton Content="A layer folder (its build or release folder)" GroupName="Layer" IsChecked="{x:Bind ViewModel.LayerFromFolder, Mode=TwoWay}" />
                    <Grid Margin="28,0,0,0" ColumnSpacing="8" Visibility="{x:Bind ViewModel.LayerFromFolder, Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox PlaceholderText="C:\Users\you\Projects\dreamair-vk-layer\build" Text="{x:Bind ViewModel.LayerFolder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="1" Click="OnBrowseLayer" Content="Browse…" />
                    </Grid>
                </StackPanel>

                <StackPanel Spacing="8">
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Extra environment" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="These override the Monado settings for this profile."
                        TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Extra}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:EnvRow">
                                <Grid Margin="0,0,0,8" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="3*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox PlaceholderText="Name" Text="{x:Bind Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox Grid.Column="1" PlaceholderText="Value (empty removes it)" Text="{x:Bind Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button
                                        Grid.Column="2"
                                        Click="OnRemoveVariable"
                                        Content="&#xE711;"
                                        FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                        ToolTipService.ToolTip="Remove" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Command="{x:Bind ViewModel.AddVariableCommand}" Content="Add a variable" />
                </StackPanel>

                <ItemsControl ItemsSource="{x:Bind ViewModel.Problems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <TextBlock
                                Margin="0,0,0,4"
                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                Text="{x:Bind}"
                                TextWrapping="Wrap" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Command="{x:Bind ViewModel.SaveCommand}" Content="Save" Style="{StaticResource AccentButtonStyle}" />
                    <Button Command="{x:Bind ViewModel.RevertCommand}" Content="Revert" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
