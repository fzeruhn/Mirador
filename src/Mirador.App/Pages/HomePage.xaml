<Page
    x:Class="Mirador.App.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:Mirador.App.Controls"
    xmlns:vm="using:Mirador.App.ViewModels"
    NavigationCacheMode="Required">

    <Page.Resources>
        <!-- The cards: Monado's status and the runtimes. -->
        <Style x:Key="HomeCard" TargetType="Border">
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
    </Page.Resources>

    <!--
        Spacing from Microsoft's "Content layout and spacing": 12 between content areas, 8 between controls of one
        group. Every message (InfoBar) is in one group under the cards, so a message coming or going never moves the
        controls above it, and a closed bar takes no room.
    -->
    <ScrollViewer>
        <c:PageColumn>
        <StackPanel Padding="36,24,36,36" Spacing="12">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Home" />

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox
                    MinWidth="260"
                    Header="Profile"
                    IsEnabled="{x:Bind ViewModel.CanChangeProfile, Mode=OneWay}"
                    ItemsSource="{x:Bind ViewModel.Profiles}"
                    SelectedItem="{x:Bind ViewModel.SelectedProfile, Mode=TwoWay, Converter={StaticResource ProfileConverter}}" />
                <Button
                    Grid.Column="1"
                    MinWidth="140"
                    VerticalAlignment="Bottom"
                    Command="{x:Bind ViewModel.StartStopCommand}"
                    Content="{x:Bind ViewModel.StartStopLabel, Mode=OneWay}"
                    IsEnabled="{x:Bind ViewModel.CanStartStop, Mode=OneWay}"
                    Style="{StaticResource AccentButtonStyle}" />
            </Grid>

            <Border Style="{StaticResource HomeCard}">
                <ItemsControl ItemsSource="{x:Bind ViewModel.Status}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:StatusItem">
                            <Grid MinHeight="36" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon
                                    VerticalAlignment="Center"
                                    FontSize="16"
                                    Foreground="{x:Bind Brush}"
                                    Glyph="{x:Bind Glyph}" />
                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                    Text="{x:Bind Label}" />
                                <TextBlock
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Text="{x:Bind Text}"
                                    TextWrapping="Wrap" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <!-- The controllers and trackers Monado found, while it runs with the Lighthouse receiver. -->
            <Border Style="{StaticResource HomeCard}" Visibility="{x:Bind ViewModel.ShowDevices, Mode=OneWay}">
                <StackPanel Padding="0,4" Spacing="8">
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Controllers and trackers" />
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.Devices}">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout
                                MinColumnSpacing="8"
                                MinItemWidth="160"
                                MinRowSpacing="8" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:DeviceItem">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon
                                        VerticalAlignment="Center"
                                        FontSize="20"
                                        Glyph="{x:Bind Glyph}" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Kind}" />
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="{x:Bind Serial}"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="None found yet."
                        Visibility="{x:Bind ViewModel.HasNoDevices, Mode=OneWay}" />
                </StackPanel>
            </Border>

            <!-- The runtimes games use. Each row is as tall with its button as without it. -->
            <Border Style="{StaticResource HomeCard}">
                <StackPanel>
                    <Grid MinHeight="36" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon
                            VerticalAlignment="Center"
                            FontSize="16"
                            Foreground="{x:Bind ViewModel.OpenXrRow.Brush, Mode=OneWay}"
                            Glyph="{x:Bind ViewModel.OpenXrRow.Glyph, Mode=OneWay}" />
                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="{x:Bind ViewModel.OpenXrRow.Label, Mode=OneWay}" />
                        <TextBlock
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Text="{x:Bind ViewModel.OpenXrRow.Text, Mode=OneWay}"
                            TextWrapping="Wrap" />
                        <Button
                            Grid.Column="3"
                            VerticalAlignment="Center"
                            Command="{x:Bind ViewModel.SetRuntimeCommand}"
                            Content="Set Monado"
                            ToolTipService.ToolTip="Make this profile's Monado the OpenXR runtime"
                            Visibility="{x:Bind ViewModel.CanSetRuntime, Mode=OneWay}" />
                    </Grid>

                    <Grid
                        MinHeight="36"
                        ColumnSpacing="12"
                        Visibility="{x:Bind ViewModel.ShowOpenVr, Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon
                            VerticalAlignment="Center"
                            FontSize="16"
                            Foreground="{x:Bind ViewModel.OpenVrRow.Brush, Mode=OneWay}"
                            Glyph="{x:Bind ViewModel.OpenVrRow.Glyph, Mode=OneWay}" />
                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="{x:Bind ViewModel.OpenVrRow.Label, Mode=OneWay}" />
                        <TextBlock
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Text="{x:Bind ViewModel.OpenVrRow.Text, Mode=OneWay}"
                            TextWrapping="Wrap" />
                        <Button
                            Grid.Column="3"
                            VerticalAlignment="Center"
                            Command="{x:Bind ViewModel.SetOpenCompositeCommand}"
                            Content="Set OpenComposite"
                            ToolTipService.ToolTip="Send OpenVR (SteamVR) games to Monado through OpenComposite"
                            Visibility="{x:Bind ViewModel.CanSetOpenComposite, Mode=OneWay}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- The base stations of the selected profile, switched together. -->
            <Border Style="{StaticResource HomeCard}" Visibility="{x:Bind ViewModel.ShowStations, Mode=OneWay}">
                <Grid MinHeight="36" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon
                        VerticalAlignment="Center"
                        FontSize="16"
                        Foreground="{x:Bind ViewModel.StationsRow.Brush, Mode=OneWay}"
                        Glyph="{x:Bind ViewModel.StationsRow.Glyph, Mode=OneWay}" />
                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="{x:Bind ViewModel.StationsRow.Label, Mode=OneWay}" />
                    <TextBlock
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Text="{x:Bind ViewModel.StationsRow.Text, Mode=OneWay}"
                        TextWrapping="Wrap" />
                    <StackPanel
                        Grid.Column="3"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="8"
                        Visibility="{x:Bind ViewModel.ShowStationButtons, Mode=OneWay}">
                        <Button
                            Command="{x:Bind ViewModel.SwitchStationsOnCommand}"
                            Content="On"
                            IsEnabled="{x:Bind ViewModel.CanSwitchStations, Mode=OneWay}" />
                        <Button
                            Command="{x:Bind ViewModel.SwitchStationsOffCommand}"
                            Content="Off"
                            IsEnabled="{x:Bind ViewModel.CanSwitchStations, Mode=OneWay}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!--
                Messages: each bar takes room only while open. Only something that happened once can be closed; a
                condition stays until it no longer holds (a failed Start until the next Start or profile).
            -->
            <StackPanel Spacing="8">
                <InfoBar
                    Title="Monado didn't start"
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.HasFailure, Mode=OneWay}"
                    Message="{x:Bind ViewModel.LastFailure, Mode=OneWay}"
                    Severity="Error"
                    Visibility="{Binding IsOpen, RelativeSource={RelativeSource Mode=Self}, Converter={StaticResource VisibleWhenTrue}}" />

                <InfoBar
                    Title="OpenXR runtime"
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.HasRuntimeProblem, Mode=OneWay}"
                    Message="{x:Bind ViewModel.RuntimeProblem, Mode=OneWay}"
                    Severity="Error"
                    Visibility="{Binding IsOpen, RelativeSource={RelativeSource Mode=Self}, Converter={StaticResource VisibleWhenTrue}}" />

                <InfoBar
                    Title="OpenXR runtime"
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.HasRuntimeNotice, Mode=OneWay}"
                    Message="{x:Bind ViewModel.RuntimeNotice, Mode=OneWay}"
                    Severity="Warning"
                    Visibility="{Binding IsOpen, RelativeSource={RelativeSource Mode=Self}, Converter={StaticResource VisibleWhenTrue}}" />

                <InfoBar
                    Title="OpenVR runtime"
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.HasOpenVrProblem, Mode=OneWay}"
                    Message="{x:Bind ViewModel.OpenVrProblem, Mode=OneWay}"
                    Severity="Error"
                    Visibility="{Binding IsOpen, RelativeSource={RelativeSource Mode=Self}, Converter={StaticResource VisibleWhenTrue}}" />

                <InfoBar
                    Title="OpenVR runtime"
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.HasOpenVrWarning, Mode=OneWay}"
                    Message="{x:Bind ViewModel.OpenVrWarning, Mode=OneWay}"
                    Severity="Warning"
                    Visibility="{Binding IsOpen, RelativeSource={RelativeSource Mode=Self}, Converter={StaticResource VisibleWhenTrue}}" />

                <InfoBar
                    Title="A new version"
                    IsClosable="True"
                    IsOpen="{x:Bind ViewModel.HasUpdate, Mode=OneWay}"
                    Message="{x:Bind ViewModel.UpdateText, Mode=OneWay}"
                    Severity="Informational"
                    Visibility="{Binding IsOpen, RelativeSource={RelativeSource Mode=Self}, Converter={StaticResource VisibleWhenTrue}}">
                    <InfoBar.ActionButton>
                        <HyperlinkButton Content="Release notes" NavigateUri="{x:Bind ViewModel.UpdateUrl, Mode=OneWay}" />
                    </InfoBar.ActionButton>
                </InfoBar>

                <!-- Last, so that an empty list only adds room below everything. -->
                <ItemsControl ItemsSource="{x:Bind ViewModel.Notices}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="8" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:NoticeItem">
                            <InfoBar
                                Title="{x:Bind Title}"
                                Closed="OnNoticeClosed"
                                IsClosable="{x:Bind IsClosable}"
                                IsOpen="True"
                                Message="{x:Bind Message}"
                                Severity="{x:Bind Severity}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </StackPanel>
        </c:PageColumn>
    </ScrollViewer>
</Page>
