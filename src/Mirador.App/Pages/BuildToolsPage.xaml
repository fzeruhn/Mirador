<Page
    x:Class="Mirador.App.Pages.BuildToolsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:vm="using:Mirador.App.ViewModels">

    <ScrollViewer>
        <StackPanel Padding="36,24,36,24" Spacing="4">
            <TextBlock Style="{StaticResource PageTitle}" Text="Build tools" />
            <TextBlock
                Margin="0,0,0,12"
                Text="What Mirador needs to build a Monado branch. Microsoft's compiler and Windows SDK come from Visual Studio's own installer; vcpkg, CMake, Ninja and Git are Mirador's copies, at the versions every build uses."
                TextWrapping="Wrap" />

            <ItemsControl ItemsSource="{x:Bind ViewModel.Parts}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="4" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:BuildToolPartItem">
                        <toolkit:SettingsCard Description="{x:Bind Detail}" Header="{x:Bind Name}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="16" Glyph="{x:Bind Glyph}" />
                                <TextBlock VerticalAlignment="Center" Text="{x:Bind State}" />
                            </StackPanel>
                        </toolkit:SettingsCard>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <InfoBar
                Margin="0,8,0,0"
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.HasSummary, Mode=OneWay}"
                Message="{x:Bind ViewModel.Summary, Mode=OneWay}"
                Severity="{x:Bind ViewModel.SummarySeverity, Mode=OneWay}" />

            <StackPanel
                Margin="0,8,0,0"
                Orientation="Horizontal"
                Spacing="8">
                <Button Click="OnBack" Content="Back" />
                <Button Command="{x:Bind ViewModel.CheckCommand}" Content="Check again" />
                <Button
                    Command="{x:Bind ViewModel.InstallCommand}"
                    Content="Install what's missing"
                    Style="{StaticResource AccentButtonStyle}" />
                <ProgressRing
                    Width="20"
                    Height="20"
                    IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
            </StackPanel>

            <TextBox
                MinHeight="160"
                Margin="0,12,0,0"
                AcceptsReturn="True"
                FontFamily="Consolas"
                Header="Install log"
                IsReadOnly="True"
                Text="{x:Bind ViewModel.Log, Mode=OneWay}"
                TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Page>
